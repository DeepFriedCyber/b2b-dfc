  "concepts": [
    {
      "concept_id": "security_operations_center",
      "preferred_label": "Security Operations Center",
      "definition": "An organisational function and operating model that continuously monitors, triages and responds to security events across an estate.",
      "domains": ["CYBERSECURITY"],
      "concept_type": "CAPABILITY",
      "status": "ACTIVE",
      "terminology_maturity": "ESTABLISHED"
    },
    {
      "concept_id": "managed_detection_and_response",
      "preferred_label": "Managed Detection and Response",
      "definition": "A commercially delivered service category in which a provider monitors and responds to security events on a customer's behalf.",
      "domains": ["CYBERSECURITY"],
      "concept_type": "SERVICE_CATEGORY",
      "status": "ACTIVE",
      "terminology_maturity": "ESTABLISHED"
    },
    {
      "concept_id": "endpoint_detection_and_response",
      "preferred_label": "Endpoint Detection and Response",
